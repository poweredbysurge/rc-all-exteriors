---
// 404 (404-390, 404-1440). Copy is DRAFT, written to master prompt section 16.
import Base from '@/layouts/Base.astro';
import Cta from '@/components/Cta.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Section from '@/components/Section.astro';
import { PHONE } from '@/lib/site';

const links = [
  ['/roof-replacement/', 'Roof Replacement'],
  ['/roof-repair/', 'Roof Repair'],
  ['/storm-damage-roof-repair/', 'Storm Damage'],
  ['/free-roof-inspection/', 'Free Roof Inspection'],
  ['/service-areas/', 'Service Areas'],
  ['/reviews/', 'Reviews'],
];
---

<Base title="Page Not Found | RC All Exteriors, Woodbridge, VA" description="That page is not here. Find roof replacement, roof repair, storm damage help and free roof inspections from RC All Exteriors in Woodbridge, VA." path="/404/" noindex>
  <Section bg="surface" name="404">
    <div class="flex max-w-[720px] flex-col gap-8">
      <Eyebrow>404</Eyebrow>
      <h1 class="heading text-h1 text-fg">That page is not here</h1>
      <p class="text-fg-muted">The address may have changed when we rebuilt the site. Pick a service below, or call or text us and we'll point you the right way.</p>
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {links.map(([href, label]) => <li><a href={href} class="chip">{label}</a></li>)}
      </ul>
      <div class="flex flex-col gap-3 btn:flex-row">
        <Cta to="/free-roof-inspection/">Book a Free Roof Inspection</Cta>
        <Cta to="tel" variant="secondary">Call or text {PHONE}</Cta>
      </div>
    </div>
  </Section>
</Base>
