---
// Guides index (ADR-018). Copy: copy/guides-1.md section 1. One card per
// guide: title and line from the index copy, date from the guide's own spec.
// Category filter chips (master prompt section 9) wait until there are enough
// guides to filter.
import Base from '@/layouts/Base.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import Rich from '@/components/Rich.astro';
import Section from '@/components/Section.astro';
import { blocksOf, first, getPage, plain, section } from '@/lib/copy';
import { metaFor } from '@/lib/page';
import { sentenceCase } from '@/lib/text';
import { itemListSchema, pageSchema } from '@/lib/schema';

const path = '/guides/';
const page = getPage(path);
const meta = metaFor(page);
const hero = section(page, 'Hero');
const cta = section(page, 'CTA');
const h1 = plain(first(hero, 'h1')!.inline);
const cards = blocksOf(section(page, 'Guides'), 'card').map((card) => {
  const published = getPage(card.href!).published!;
  return { ...card, published, date: new Date(published).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }) };
});
---

<Base
  title={meta.title}
  description={meta.description}
  path={path}
  confirmMeta={meta.confirmMeta}
  schema={[pageSchema('CollectionPage', { path, name: h1, description: meta.description }), itemListSchema(cards.map((c) => ({ name: c.title, href: c.href! })))]}
>
  <PageHero path={path} h1={h1} lede={first(hero, 'subhead')?.inline} />

  <Section bg="surface" name="Guides">
    <ul class="m-0 grid list-none grid-cols-1 gap-5 p-0 md:grid-cols-2 lg:gap-6">
      {
        cards.map((card) => (
          <li>
            <a href={card.href} class="card h-full gap-3">
              <p class="text-body-sm font-semibold text-fg-muted" data-sm>
                <time datetime={card.published}>{card.date}</time> · By Ricardo Castro
              </p>
              <h2 class="heading text-h3 text-fg">{sentenceCase(card.title)}</h2>
              <p class="text-fg-muted"><Rich inline={card.inline} /></p>
              <span class="mt-auto inline-flex items-center gap-1.5 text-body-sm font-semibold text-accent">
                Read the guide <Icon name="arrow-right" size={18} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaBand heading={first(cta, 'h2')!.inline} text={first(cta, 'p')?.inline} primary={blocksOf(cta, 'cta').find((c) => c.kind === 'primary')} />
</Base>
