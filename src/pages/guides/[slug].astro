---
// Guides (ADR-018): flat /guides/<slug>/ URLs under the Resources hub. One page
// per copy page under /guides/; the layout is ArticlePage.
import ArticlePage from '@/components/ArticlePage.astro';
import { guides } from '@/data/nav';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.href.split('/')[2] }, props: { path: g.href } }));
}
const { path } = Astro.props as { path: string };
---

<ArticlePage path={path} formId="guide" />
