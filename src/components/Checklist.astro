---
// Checklist card on the accent tint, with the check icon aligned to the first line.
import Icon from './Icon.astro';
import Rich from './Rich.astro';
import type { ListItem } from '@/lib/copy';

interface Props {
  items: ListItem[];
  columns?: 1 | 2;
  class?: string;
}
const { items, columns = 1, class: className } = Astro.props;
---

<ul class:list={['m-0 grid list-none gap-5 rounded-lg bg-accent-tint p-5 lg:gap-x-10 lg:p-8', columns === 2 && 'lg:grid-cols-2', className]}>
  {
    items.map((item) => (
      <li class="rich flex gap-3 text-fg">
        <Icon name="check" size={24} class="mt-0.5 text-accent" />
        <span>
          {item.title && <strong class="font-bold text-fg">{item.title} </strong>}
          <Rich inline={item.inline} />
        </span>
      </li>
    ))
  }
</ul>
