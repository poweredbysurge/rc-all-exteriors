---
// The lead card: the HomeSource two-step contract, shown as quiz panes
// (master prompt section 10, ADR-005).
//
// Step 1 is two panes. Pane 1 asks the one question that takes a tap ("What's
// going on?"); pane 2 collects name, phone, email, zip and SMS consent, and
// its submit is the step 1 POST that captures the lead. Nothing is sent before
// it. Step 2 is optional qualification, one question per pane, Skip always
// visible, and it can never lose the lead. src/scripts/lead.ts drives panes,
// validation, submit, retry and analytics.
//
// Without JS every pane is visible and the reason options are plain radios,
// so the markup is one ordinary form.
//
// Field names are the Command Center contract. Do not rename them.
import Icon from './Icon.astro';
import { BEST_TIMES, CONTACT_REASONS, REASONS, ROOF_AGES, URGENCIES } from '@/data/lead-form';
import { esc } from '@/lib/render';
import { CONSENT_TEXT, CONSENT_TEXT_VERSION, PHONE, TEL } from '@/lib/site';

interface Props {
  /** Unique per page and sent as form_id: "hero", "inspection", "contact". */
  formId: string;
  variant?: 'card' | 'contact';
  heading?: string;
  sub?: string;
  submitLabel?: string;
  class?: string;
}
const {
  formId,
  variant = 'card',
  heading = 'Book your free inspection',
  sub = 'Two quick steps. We do the rest.',
  submitLabel = 'Book a Free Roof Inspection',
  class: className,
} = Astro.props;

const isContact = variant === 'contact';
const id = (name: string) => `${formId}-${name}`;
const reasons = isContact ? CONTACT_REASONS : REASONS;
const reasonLabel = isContact ? 'What do you need?' : "What's going on?";
// The label is rendered from the one consent string whose version is stored
// with every submission, so the text and its version cannot drift apart.
const consentHtml = esc(CONSENT_TEXT)
  .replace('Privacy Policy', '<a href="/privacy-policy/">Privacy Policy</a>')
  .replace('SMS Terms', '<a href="/sms-terms/">SMS Terms</a>');

// Step 2 panes, in order. Each is one question.
const step2Panes = ['address', 'roof_age', 'urgency', 'best_time'] as const;
---

<div
  id="lead-card"
  data-lead-card
  data-form-id={formId}
  data-variant={variant}
  data-consent-version={CONSENT_TEXT_VERSION}
  data-phone={PHONE}
  data-tel={TEL}
  class:list={['flex w-full flex-col rounded-lg bg-surface px-5 py-6 text-fg shadow-md lg:p-8', className]}
>
  <!-- Step 1: pane 1 (reason) then pane 2 (contact). One form, so no-JS still works. -->
  <form data-step="1" novalidate class="flex flex-col gap-5" aria-labelledby={id('heading')}>
    <div class="flex flex-col gap-2">
      <h2 id={id('heading')} class="heading text-h3 text-fg">{heading}</h2>
      <div class="quiz-head flex items-center justify-between gap-3" data-quiz-head>
        {sub && <p class="text-body-sm text-fg-muted" data-sm data-quiz-sub>{sub}</p>}
        <button type="button" class="quiz-back" data-action="back" hidden>
          <Icon name="arrow-left" size={18} />
          Back
        </button>
        <span class="quiz-count" data-quiz-count aria-live="polite"></span>
      </div>
      <div class="quiz-bar" data-quiz-bar aria-hidden="true"><i></i></div>
    </div>

    <!-- Pane 1: the one-tap question -->
    <fieldset data-pane="reason" class="flex flex-col gap-3">
      <legend class="field-label mb-3">{reasonLabel}</legend>
      <div class="flex flex-col gap-2.5" data-reason-options>
        {
          reasons.map((r, i) => (
            <label class="option">
              <input class="sr-only" type="radio" name="reason" value={r.key} data-label={r.label} data-index={i} required />
              <span class="option-label">{r.label}</span>
              <Icon name="arrow-right" size={20} class="option-arrow" />
            </label>
          ))
        }
      </div>
      <p class="mt-1 text-center text-body-sm font-semibold text-fg" data-sm>About 30 seconds, no obligation</p>
    </fieldset>

    <!-- Pane 2: contact. Submitting this is the step 1 POST. -->
    <div data-pane="contact" class="flex flex-col gap-4">
      <p class="field-label mb-0" data-pane-title tabindex="-1">How do we reach you?</p>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-[minmax(0,1fr)_132px]">
        <div>
          <label class="field-label" for={id('full_name')}>Full name <span class="field-hint">(required)</span></label>
          <input class="field" id={id('full_name')} name="full_name" type="text" autocomplete="name" required />
        </div>
        <div>
          <label class="field-label" for={id('zip')}>Zip code <span class="field-hint sm:sr-only">(required)</span></label>
          <input class="field" id={id('zip')} name="zip" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="5" required />
        </div>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="field-label" for={id('phone')}>Phone <span class="field-hint">(required)</span></label>
          <input class="field" id={id('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" required />
        </div>
        <div>
          <label class="field-label" for={id('email')}>Email <span class="field-hint">(required)</span></label>
          <input class="field" id={id('email')} name="email" type="email" inputmode="email" autocomplete="email" required />
        </div>
      </div>
      {
        isContact && (
          <div>
            <label class="field-label" for={id('address_street')}>Street address <span class="field-hint">(optional)</span></label>
            <input class="field" id={id('address_street')} name="address_street" type="text" autocomplete="street-address" />
          </div>
        )
      }
      {
        isContact && (
          <div>
            <label class="field-label" for={id('notes')}>Message <span class="field-hint">(optional)</span></label>
            <textarea class="field" id={id('notes')} name="notes" rows="3" />
          </div>
        )
      }
      <label class="flex cursor-pointer items-start gap-3" for={id('consent_sms')}>
        <input
          class="consent-box mt-0.5 size-6 shrink-0 cursor-pointer rounded-sm border border-border-strong accent-accent"
          id={id('consent_sms')}
          name="consent_sms"
          type="checkbox"
        />
        <span class="rich text-body-sm leading-normal text-fg-muted" data-sm data-consent-text set:html={consentHtml} />
      </label>
      <!-- Honeypot. Hidden from people and assistive tech; a filled value means a bot. -->
      <div class="absolute -left-[9999px] size-px overflow-hidden" aria-hidden="true">
        <label for={id('company_website')}>Leave this field empty</label>
        <input id={id('company_website')} name="company_website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div data-form-alert role="alert" aria-live="polite" class="rich rounded-md border border-error bg-error-tint px-3.5 py-3 text-body-sm text-error" data-sm hidden></div>

      <button type="submit" class="btn btn-primary btn-block" data-action="submit">
        <span data-label>{submitLabel}</span>
      </button>
    </div>

    <p class="text-center text-body-sm text-fg-muted" data-sm>
      Or call or text <a href={TEL} class="font-bold whitespace-nowrap text-accent hover:underline">{PHONE}</a>
    </p>
  </form>

  {
    !isContact && (
      <form data-step="2" novalidate class="flex flex-col gap-5" aria-labelledby={id('heading2')} hidden>
        <div class="flex flex-col gap-2">
          <h2 id={id('heading2')} class="heading text-h3 text-fg" tabindex="-1">
            A few more details help us prep for your visit. All optional.
          </h2>
          <div class="quiz-head flex items-center justify-between gap-3" data-quiz-head>
            <button type="button" class="quiz-back" data-action="back" hidden>
              <Icon name="arrow-left" size={18} />
              Back
            </button>
            <span class="quiz-count" data-quiz-count aria-live="polite" />
          </div>
          <div class="quiz-bar" data-quiz-bar aria-hidden="true">
            <i />
          </div>
        </div>

        <div data-pane="address">
          <label class="field-label" for={id('address_street')}>
            Street address <span class="field-hint">(optional)</span>
          </label>
          <input class="field" id={id('address_street')} name="address_street" type="text" autocomplete="street-address" />
        </div>
        <fieldset data-pane="roof_age">
          <legend class="field-label">
            Roof age <span class="field-hint">(optional)</span>
          </legend>
          <div class="flex flex-wrap gap-2">
            {ROOF_AGES.map((o) => (
              <label class="chip chip-radio cursor-pointer">
                <input class="sr-only" type="radio" name="roof_age" value={o.key} />
                {o.label}
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset data-pane="urgency">
          <legend class="field-label">
            How soon <span class="field-hint">(optional)</span>
          </legend>
          <div class="flex flex-wrap gap-2">
            {URGENCIES.map((o) => (
              <label class="chip chip-radio cursor-pointer">
                <input class="sr-only" type="radio" name="urgency" value={o.key} />
                {o.label}
              </label>
            ))}
          </div>
        </fieldset>
        <div data-pane="best_time">
          <label class="field-label" for={id('best_time')}>
            Best time to reach you <span class="field-hint">(optional)</span>
          </label>
          <div class="relative">
            <select class="field" id={id('best_time')} name="best_time">
              <option value="">Choose one</option>
              {BEST_TIMES.map((t) => (
                <option value={t}>{t}</option>
              ))}
            </select>
            <Icon name="chevron-down" size={20} class="pointer-events-none absolute top-1/2 right-3.5 -translate-y-1/2 text-fg-muted" />
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <button type="submit" class="btn btn-primary btn-block" data-action="finish" data-finish-label="Finish" data-next-label="Next">
            <span data-label>Finish</span>
          </button>
          <button type="button" class="min-h-11 cursor-pointer text-center text-body-sm text-fg-muted underline underline-offset-4 hover:text-fg" data-action="skip">
            Skip
          </button>
        </div>
      </form>
    )
  }

  <!-- Success. Copy is the approved confirmation sentence; "what happens next" is DRAFT. -->
  <div data-step="success" class="flex flex-col gap-5" hidden>
    <h2 class="heading text-h3 text-fg" tabindex="-1" data-success-heading>
      {
        isContact ? (
          <Fragment>
            Thanks. We call back fast, usually within minutes during business hours.
          </Fragment>
        ) : (
          <Fragment>
            Got it. We call back fast, usually within minutes during business hours, to set a time.
          </Fragment>
        )
      }
    </h2>
    <p class="text-fg">
      What happens next: we confirm a time, inspect the roof, and give you a straight answer with a written estimate if work is needed.
    </p>
    <p class="text-fg">
      Need us sooner? Call or text <a href={TEL} class="font-bold whitespace-nowrap text-accent hover:underline">{PHONE}</a>.
    </p>
    <div class="flex flex-col">
      <a href="/roof-replacement/" class="link-arrow">Roof replacement <Icon name="arrow-right" size={18} /></a>
      <a href="/roof-repair/" class="link-arrow">Roof repair <Icon name="arrow-right" size={18} /></a>
      <a href="/reviews/" class="link-arrow">Read our reviews <Icon name="arrow-right" size={18} /></a>
    </div>
  </div>
</div>

<style is:global>
  /* One-tap option rows (pane 1). A radio styled as a full-width row, so the
     keyboard gets native radio behavior and a click advances the pane. */
  .option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: var(--rc-control-height);
    padding: 0 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-fg);
    font-weight: 600;
    font-size: var(--text-body);
    line-height: 1.2;
    cursor: pointer;
    transition:
      border-color 140ms cubic-bezier(0.4, 0, 0.2, 1),
      background-color 140ms cubic-bezier(0.4, 0, 0.2, 1),
      color 140ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .option-arrow {
    color: var(--color-fg-subtle);
    transition:
      transform 160ms cubic-bezier(0.4, 0, 0.2, 1),
      color 140ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .option:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .option:hover .option-arrow {
    color: var(--color-accent);
    transform: translateX(3px);
  }
  .option:has(:checked) {
    background: var(--color-accent-tint);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .option:has(:checked) .option-arrow {
    color: var(--color-accent);
  }
  .option:has(:focus-visible) {
    outline: var(--rc-focus-ring);
    outline-offset: var(--rc-focus-ring-offset);
  }

  /* Pane chrome: back link, "1 of 2" counter, thin progress bar. Hidden
     without JS, when every pane shows at once and there is nothing to page. */
  .quiz-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-fg-muted);
    cursor: pointer;
  }
  .quiz-back:hover {
    color: var(--color-accent);
  }
  .quiz-count {
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-fg-subtle);
    white-space: nowrap;
  }
  .quiz-bar {
    display: none;
    height: var(--rc-quiz-bar-height);
    border-radius: 999px;
    background: var(--color-surface-subtle);
    overflow: hidden;
  }
  .quiz-bar i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--color-accent);
    transition: width 250ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .js [data-lead-card] .quiz-bar {
    display: block;
  }
  .js [data-lead-card] [data-pane][hidden] {
    display: none;
  }
  .js [data-lead-card] [data-pane]:not([hidden]) {
    animation: pane-in 220ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  @keyframes pane-in {
    from {
      opacity: 0;
      transform: translateX(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .js [data-lead-card] [data-pane]:not([hidden]) {
      animation: none;
    }
  }

  .chip-radio:has(:checked) {
    background: var(--color-accent-tint);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .chip-radio:has(:focus-visible) {
    outline: var(--rc-focus-ring);
    outline-offset: var(--rc-focus-ring-offset);
  }
  [data-lead-card] fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
</style>

<script>
  import '@/scripts/lead';
</script>
