---
// The one chip that carries two facts: source, stars, rating and count.
// Rendered from the reviews proxy at build; site.ts refreshes the numbers from
// /api/reviews/ after load so the chip stays current between deploys.
import Stars from './Stars.astro';
import { getReviews, ratingText } from '@/lib/reviews';

interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: className } = Astro.props;
const reviews = await getReviews();
---

<span
  data-rating-chip
  class:list={[
    'inline-flex min-h-11 items-center gap-2 rounded-md border px-2.5 text-body-sm xs:gap-2.5 xs:px-3.5 font-semibold leading-none whitespace-nowrap',
    variant === 'dark'
      ? 'border-fg-inverse/30 bg-fg-inverse/[0.08] text-fg-inverse'
      : 'border-border bg-surface text-fg',
    className,
  ]}
>
  <span>Google</span>
  <Stars rating={reviews.rating} size={16} class={variant === 'dark' ? 'text-fg-inverse/90' : 'text-accent'} />
  <span data-rating-value>{ratingText(reviews.rating)}</span>
  <span class:list={['font-medium', variant === 'dark' ? 'text-fg-inverse-muted' : 'text-fg-muted']}>
    <span data-rating-count>{reviews.count}</span> reviews
  </span>
</span>
