---
// The CertainTeed ShingleMaster Credentialed badge (ADR-016): CertainTeed's own
// artwork, cut from its white square, shown under the H2 of the sections that
// argue for the credential (BADGE_SECTIONS in src/data/brands.ts) and in the
// footer in place of the words. It links to CertainTeed's Find a Pro profile,
// the proof. Text mentions in sentences and the trust strip stay text.
import { getImage } from 'astro:assets';
import { shingleMaster } from '@/data/brands';

interface Props {
  /** section: 120px, 160px from lg. footer: 72px beside the rating chip. */
  size?: 'section' | 'footer';
  class?: string;
}
const { size = 'section', class: className } = Astro.props;

// 2x the largest rendered height, WebP through the pipeline.
const h = size === 'footer' ? 144 : 320;
const w = Math.round((shingleMaster.image.width / shingleMaster.image.height) * h);
const img = await getImage({ src: shingleMaster.image, width: w, height: h, format: 'webp', quality: 85 });
---

<a href={shingleMaster.profile} target="_blank" rel="noopener" class:list={['self-start', className]} title={`${shingleMaster.claim}: see the CertainTeed profile`}>
  <img src={img.src} alt={shingleMaster.claim} width={w} height={h} loading="lazy" decoding="async" class:list={['block w-auto', size === 'footer' ? 'h-[72px]' : 'h-[120px] lg:h-[160px]']} />
</a>
