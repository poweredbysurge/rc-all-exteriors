---
// Trust row under the hero lede: the live Google rating chip, then the copy's
// own [TRUST BAR] items, divided by thin rules.
//
// On phones only the first `mobileCount` items show (Gate A review finding 2):
// the rest already live in the stat strip below, and the hero has to get the
// visitor to the form.
import Icon from './Icon.astro';
import RatingChip from './RatingChip.astro';
import Rich from './Rich.astro';
import { plain, type Inline } from '@/lib/copy';

interface Props {
  items: Inline[][];
  mobileCount?: number;
  class?: string;
}
const { items, mobileCount = 1, class: className } = Astro.props;

// The rating chip already states the review count, so a "49 five-star reviews"
// item in the copy's trust bar is represented by the chip, not repeated.
const rest = items.filter((item) => !/five-star/i.test(plain(item)));

function iconFor(text: string): string {
  const t = text.toLowerCase();
  if (/warranty/.test(t)) return 'shield-check';
  if (/class a|licen[cs]ed/.test(t)) return 'badge-check';
  if (/bbb|certainteed/.test(t)) return 'award';
  if (/financing/.test(t)) return 'credit-card';
  if (/residential and commercial/.test(t)) return 'building-2';
  if (/insurance|storm/.test(t)) return 'cloud-lightning';
  if (/quick/.test(t)) return 'clock';
  if (/inspection/.test(t)) return 'clipboard-check';
  if (/insured/.test(t)) return 'shield-check';
  return 'map-pin';
}
---

<ul class:list={['flex flex-col flex-wrap items-center justify-center gap-y-2 lg:flex-row lg:justify-start', className]}>
  <li class="flex items-center">
    <RatingChip variant="dark" />
  </li>
  {
    rest.map((item, i) => (
      <li class:list={['items-center', i < mobileCount ? 'flex' : 'hidden lg:flex']}>
        <span aria-hidden="true" class="mx-3.5 hidden h-4 w-px bg-fg-inverse/30 lg:inline-block" />
        <span class="inline-flex items-center gap-2 text-body-sm leading-snug font-semibold text-fg-inverse">
          <Icon name={iconFor(plain(item))} size={20} class="text-fg-inverse/90" />
          <span><Rich inline={item} linkPhone={false} /></span>
        </span>
      </li>
    ))
  }
</ul>
